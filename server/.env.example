# Port du serveur Express
PORT=5000

# CORS - liste des origines autorisées (séparées par des virgules)
CLIENT_ORIGINS=http://localhost:5173,https://gamarha.vercel.app

# FotMob - pas de clé officielle requise (URL racine, sans /api)
FOTMOB_BASE_URL=https://www.fotmob.com

# Groq (IA générative cloud) - clé API gratuite sur console.groq.com
GROQ_API_KEY=votre-cle-groq-ici
GROQ_MODEL=openai/gpt-oss-120b

# Temps de réponse pour les défis IA en secondes
CHALLENGE_CACHE_SECONDS=3600